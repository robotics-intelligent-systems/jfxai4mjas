:10px;'&gt;contactors · insulation monitoring · safe-state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="1200" y="975" width="970" height="92" /></mxCell><mxCell id="s3" parent="1" value="&lt;b&gt;Fire / thermal event management&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;detection · separation · emergency procedures&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="2270" y="975" width="970" height="92" /></mxCell><mxCell id="s4" parent="1" value="&lt;b&gt;Propulsion fault containment&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;single failures / common-cause analysis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="130" y="1140" width="970" height="92" /></mxCell><mxCell id="s5" parent="1" value="&lt;b&gt;Ground servicing safety&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;authorized fueling · interlocks · status verification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="1200" y="1140" width="970" height="92" /></mxCell><mxCell id="s6" parent="1" value="&lt;b&gt;Configuration / maintenance control&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;component life · leakage history · fault/event logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="2270" y="1140" width="970" height="92" /></mxCell><mxCell id="n9" parent="1" value="This page intentionally stays at system-requirement level. It does not prescribe hydrogen vessel construction, storage pressure, detailed fueling procedure or electrical build instructions. Those details require approved standards, specialist safety analysis and certification evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="130" y="1430" width="3190" height="95" /></mxCell></root></mxGraphModel></diagram><diagram id="066768d8" name="10_BWB_H2_Cargo_Integration"><mxGraphModel dx="2500" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="2700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="BWB Hydrogen Storage + Cargo Integration Trade Space&lt;br/&gt;&lt;font style='font-size:11px;'&gt;The ZeroAvia/Natilus source explicitly links BWB volume with increased hydrogen-storage potential while maintaining payload/range intent. JFXAI4MJAS must close this through its own MDAO and structural/aero models.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="3440" height="78" /></mxCell><mxCell id="bwb" parent="1" value="BWB CENTERBODY DESIGN SPACE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1"><mxGeometry as="geometry" x="1350" y="150" width="800" height="90" /></mxCell><mxCell id="t1" parent="1" value="Cargo Volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;" vertex="1"><mxGeometry as="geometry" x="100" y="330" wid